{% extends 'base.html.twig' %}

{% block body %}
    <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-md">
        <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">Select a City</h1>

        <form method="get" action="" class="space-y-4">
            <div>
                <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
                <select name="city" id="city" class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent">
                    <option value="" disabled selected>Select a city</option>
                    <option value="Madrid">Madrid</option>
                    <option value="Paris">Paris</option>
                    <option value="London">London</option>
                    <option value="ErrorCity">Error City</option>
                </select>
            </div>

            <div class="text-center">
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold px-6 py-2 rounded-lg transition duration-300">
                    Submit
                </button>
            </div>
        </form>

        {% if app.request.query.get('city') and not error|default %}
            <div class="mt-6 text-center text-green-600 font-medium">
                You selected: {{ app.request.query.get('city')|capitalize }}
            </div>
            <div class="mt-6 text-left text-green-600 font-medium">
                Weather is:
            </div>
            <div class="mt-2 ml-20 text-left text-green-600 font-medium">
                Country: {{ weather.country }}
            </div>
            <div class="mt-2 ml-20 text-left text-green-600 font-medium">
                Temperature: {{ weather.temperature }}
            </div>
            <div class="mt-2 ml-20 text-left text-green-600 font-medium">
                Condition: {{ weather.condition }}
            </div>
            <div class="mt-2 ml-20 text-left text-green-600 font-medium">
                Humidity: {{ weather.humidity }}
            </div>
            <div class="mt-2 ml-20 text-left text-green-600 font-medium">
                Wind Speed: {{ weather.wind_speed }}
            </div>
            <div class="mt-2 ml-20 text-left text-green-600 font-medium">
                Last Updated: {{ weather.last_updated | date }}
            </div>
        {% endif %}

        {% if error|default %}
            <div class="mt-6 text-center text-green-600 font-medium">
                {{ error }}
            </div>
        {% endif %}
    </div>
{% endblock %}